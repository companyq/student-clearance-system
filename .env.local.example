# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase dashboard -> Project Settings -> API  (and  Connect -> Session pooler for DATABASE_URL)

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" key - safe for the browser; Row-Level Security limits what it can do
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key - SECRET. Server only. Used to create login accounts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only needed for `npm run db:setup` (otherwise paste supabase/schema.sql
# into the Supabase SQL Editor). Use the Session pooler connection string.
DATABASE_URL=
